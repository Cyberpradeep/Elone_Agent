# --- Primary LLM Provider API Keys --------------------------------------------
# Google Gemini API Key (Used for JIT Converter execution planning)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Mistral AI API Key (Used for Plan Validator Layer 2 faithfulness inspection)
MISTRAL_API_KEY=your_mistral_api_key_here

# NVIDIA NIM API Key (Used for Multimodal VLM Screenshot & Image Analysis)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# --- Optional / Fallback LLM Provider Keys ------------------------------------
# OpenRouter API Key (Optional fallback provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (Optional fast inference fallback)
GROQ_API_KEY=your_groq_api_key_here

# --- Knowledge Base & Pipeline Storage ----------------------------------------
# Optional: Override the local knowledge base directory (defaults to ./knowledge_base)
# ELONE_KB_DIR=./knowledge_base

# --- Scheduler & Folder Watcher Settings --------------------------------------
# Background watcher interval in minutes for scanning knowledge_base/_uploads/
SOP_SCAN_INTERVAL_MINUTES=10

# --- Cost & Daily Quota Guard Settings ----------------------------------------
# Maximum allowed daily LLM calls before circuit-breaker safety block (default: 50)
MAX_DAILY_CALLS=50
