# --- Primary LLM Provider API Keys --------------------------------------------
# Google Gemini API Key (Used for JIT Converter execution planning)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Mistral AI API Key (Used for Plan Validator Layer 2 faithfulness inspection)
MISTRAL_API_KEY=your_mistral_api_key_here

# NVIDIA NIM API Key (Used for Multimodal VLM Screenshot & Image Analysis)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# --- Alternative / Fallback LLM Providers ---------------------------------------
# Groq API Key (Ultra-fast inference: llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen-2.5-32b)
GROQ_API_KEY=your_groq_api_key_here

# Z.ai / Zhipu AI GLM API Key (Models: glm-4-flash, glm-4-plus, glm-4-air, glm-4-long)
ZAI_API_KEY=your_zai_or_glm_api_key_here
# Optional: Z.ai Base URL (Defaults to international endpoint: https://api.z.ai/api/paas/v4)
# For mainland China users, set to: https://open.bigmodel.cn/api/paas/v4
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# OpenRouter API Key (Optional multi-provider fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Dynamic Provider Selection (Optional Overrides) ---------------------------
# Set these if you want to use Groq or Z.ai directly as the primary planning/validation agent
# Providers supported: gemini, mistral, groq, zai (or glm), openrouter
# PLANNING_PROVIDER=groq
# PLANNING_MODEL=llama-3.3-70b-versatile
# VALIDATION_PROVIDER=zai
# VALIDATION_MODEL=glm-4-flash

# --- Knowledge Base & Pipeline Storage ----------------------------------------
# Optional: Override the local knowledge base directory (defaults to ./knowledge_base)
# ELONE_KB_DIR=./knowledge_base

# --- Scheduler & Folder Watcher Settings --------------------------------------
# Background watcher interval in minutes for scanning knowledge_base/_uploads/
SOP_SCAN_INTERVAL_MINUTES=10

# --- Cost & Daily Quota Guard Settings ----------------------------------------
# Maximum allowed daily LLM calls before circuit-breaker safety block (default: 110)
MAX_DAILY_CALLS=110
