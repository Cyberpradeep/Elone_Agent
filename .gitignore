# =============================================================================
# Elone Agent — Git Ignore Rules
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (Never commit secrets, tokens, or active API keys)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
service_account*.json
credentials.json
client_secret*.json

# -----------------------------------------------------------------------------
# Virtual Environments
# -----------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
*.venv/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Python Bytecode, Caches & Testing
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
.deepeval/
deepeval_test_cache/

# -----------------------------------------------------------------------------
# Packaging & Distribution
# -----------------------------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
pip-log.txt

# -----------------------------------------------------------------------------
# Operating System Artifacts
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# IDEs & Editor Files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# AI Agent IDE, Observability & Local Database Storage
# -----------------------------------------------------------------------------
.agents/
.cursor/
.windsurf/
.phoenix/
phoenix.db
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Microsoft Office Lock & Temporary Files (Word/Excel/PowerPoint)
# -----------------------------------------------------------------------------
~$*
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Archives & Temporary Working Directories
# -----------------------------------------------------------------------------
*.zip
*.tar.gz
scratch/
tmp/
temp/

# -----------------------------------------------------------------------------
# Knowledge Base Uploads, Drafts, Logs, Telemetry & Governance Runtime Data
# -----------------------------------------------------------------------------
*.log
*.log.*
logs/
**/logs/
knowledge_base/logs/
knowledge_base/patterns/logs/
knowledge_base/_uploads/*
!knowledge_base/_uploads/.gitkeep
!knowledge_base/_uploads/SOP_Kill_Hang_Application_Windows.pdf
!knowledge_base/_uploads/solndra_password_reset.docx
!knowledge_base/_uploads/ARVpndetails.docx

# Staged unapproved drafts, trash, quarantine & governance runtime state
**/_drafts/
**/_trash/
**/_quarantine/
**/_governance_ledger.json
**/_retrieval_catalog.json
**/_processed_manifest.json
**/_manifest.json
*.bak
*.old

# API call usage tracker, temporary trace artifacts & test SOPs
**/daily_usage.json
test_sop_*.txt
quick_trace_*.txt
*SOP-TEST-*
*.trace.json
*.trace.txt

# -----------------------------------------------------------------------------
# PDF Processing Tools & Local Documentation
# -----------------------------------------------------------------------------
.pdf_tools/
docs/
/docs
