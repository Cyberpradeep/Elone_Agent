s]:\nSkip to main content\n\n[![](https://uhf.microsoft.com/images/microsoft/RE1Mu3b.png)\nMicrosoft](https://www.microsoft.com)\n\nSupport\n\n[Support](/en-us/)\n\nSupport\n\n* [Home](/en-us/)\n* [Microsoft 365](https://www.microsoft.com/microsoft-365?ocid=cmmttvzgpuy)\n* [Office](https://www.microsoft.com/microsoft-365/microsoft-office?ocid=cmml7tr0rib)\n* [Windows](https://www.microsoft.com/en-us/windows?ocid=smc_marvel_ups_support_uhfwindows)\n* [Surface](https://www.microsoft.com/surface)\n* [Xbox](https://www.xbox.com/)\n* [Deals](https://www.microsoft.com/en-us/store/b/sale?icid=TopNavDealsSale)\n* More\n* [Buy Microsoft 365](https://go.microsoft.com/fwlink/?linkid=849747)\n\n* All Microsoft\n  + ## Global\n\n    - [Microsoft 365](https://www.microsoft.com/microsoft-365)\n    - [Azure](https://azure.microsoft.com/en-us?ocid=cmm4r4ppnhp)\n    - [Copilot](https://copilot.com/?fromcode=cmmuaql67jy)\n    - [Windows](https://www.microsoft.com/en-us/windows/)\n    - [Surface](https://www.microsoft.com/surface)\n    - [XBOX](https://www.xbox.com/)\n    - [Deals](https://www.microsoft.com/en-us/store/b/sale?icid=DSM_TopNavDeals)\n    - [Small Business](https://www.microsoft.com/en-us/store/b/business)\n    - [Support](https://support.microsoft.com/en-us)\n  + Software\n    Software\n    - [Windows Apps](https://apps.microsoft.com/home)\n    - [Outlook](https://www.microsoft.com/en-us/microsoft-365/outlook/email-and-calendar-software-microsoft-outlook)\n    - [OneDrive](https://www.microsoft.com/en-us/microsoft-365/one\n\nAI: [{'name': 'get_platform_tools', 'args': {'platform_name': 'mock'}, 'id': '0fG8XwllW', 'type': 'tool_call'}, {'name': 'get_platform_tools', 'args': {'platform_name': 'auth0'}, 'id': 'U1WP7Qm1o', 'type': 'tool_call'}, {'name': 'get_platform_tools', 'args': {'platform_name': 'email'}, 'id': '5KVnX79vY', 'type': 'tool_call'}]\nTool: {\n  \"platform\": \"mock\",\n  \"provider\": \"l1_testing_platform_api\",\n  \"description\": \"REST API client for L1 Support Platform \\u2014 covers auth, password management, MFA, admin user management, and audit logging.\",\n  \"functions\": [\n    {\n      \"function_name\": \"signup\",\n      \"description\": \"POST /api/auth/signup \\u2014 Create a new user account.\",\n      \"required_inputs\": [\n        \"email\",\n        \"password\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"user\": {\n            \"id\": \"int\",\n            \"email\": \"str\",\n            \"full_name\": \"str\"\n          }\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"login\",\n      \"description\": \"POST /api/auth/login \\u2014 Login with email and password.\",\n      \"required_inputs\": [\n        \"email\",\n        \"password\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"access_token\": \"str\",\n          \"user\": {\n            \"id\": \"int\",\n            \"email\": \"str\"\n          }\n        },\n        \"mfa_required\": {\n          \"mfa_required\": true,\n          \"temp_token\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"verify_mfa_login\",\n      \"description\": \"POST /api/auth/login/mfa \\u2014 Verify MFA code after login.\",\n      \"required_inputs\": [\n        \"temp_token\",\n        \"mfa_code\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"access_token\": \"str\",\n          \"user\": {\n            \"id\": \"int\",\n            \"email\": \"str\"\n          }\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"logout\",\n      \"description\": \"POST /api/auth/logout \\u2014 Invalidate the current access token.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_current_user\",\n      \"description\": \"GET /api/auth/me \\u2014 Get the current authenticated user profile.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"id\": \"int\",\n          \"email\": \"str\",\n          \"full_name\": \"str\",\n          \"locked\": \"bool\",\n          \"mfa_enabled\": \"bool\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"request_password_reset\",\n      \"description\": \"POST /api/password/reset-request \\u2014 Request a password reset token by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"reset_token\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"confirm_password_reset\",\n      \"description\": \"POST /api/password/reset-confirm \\u2014 Confirm password reset with token.\",\n      \"required_inputs\": [\n        \"reset_token\",\n        \"new_password\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"change_password\",\n      \"description\": \"PUT /api/password/change \\u2014 Change password for the current user.\",\n      \"required_inputs\": [\n        \"current_password\",\n        \"new_password\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_mfa_status\",\n      \"description\": \"GET /api/mfa/status \\u2014 Get MFA state (enabled/verified).\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"mfa_enabled\": \"bool\",\n          \"mfa_verified\": \"bool\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"enable_mfa\",\n      \"description\": \"POST /api/mfa/enable \\u2014 Enable MFA, returns new secret and provisioning URI.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_secret\": \"str\",\n          \"provisioning_uri\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"verify_mfa_setup\",\n      \"description\": \"POST /api/mfa/verify-setup \\u2014 Verify MFA setup with a TOTP code.\",\n      \"required_inputs\": [\n        \"mfa_code\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_verified\": \"bool\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"disable_mfa\",\n      \"description\": \"POST /api/mfa/disable \\u2014 Disable MFA for the current user.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_enabled\": false\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"reset_mfa\",\n      \"description\": \"POST /api/mfa/reset \\u2014 Reset MFA, returns new secret and provisioning URI.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_secret\": \"str\",\n          \"provisioning_uri\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"list_users\",\n      \"description\": \"GET /api/admin/users \\u2014 Get paginated list of all users.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"users\": [\n            {\n              \"id\": \"int\",\n              \"email\": \"str\",\n              \"full_name\": \"str\",\n              \"locked\": \"bool\"\n            }\n          ],\n          \"total\": \"int\",\n          \"page\": \"int\",\n          \"per_page\": \"int\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"search_users\",\n      \"description\": \"GET /api/admin/users/search?email= \\u2014 Search users by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"users\": [\n            {\n              \"id\": \"int\",\n              \"email\": \"str\",\n              \"full_name\": \"str\",\n              \"locked\": \"bool\"\n            }\n          ]\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_user_details\",\n      \"description\": \"GET /api/admin/users/{id} \\u2014 Get detailed user profile.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"id\": \"int\",\n          \"email\": \"str\",\n          \"full_name\": \"str\",\n          \"status\": \"str\",\n          \"locked\": \"bool\",\n          \"mfa_enabled\": \"bool\",\n          \"failed_login_attempts\": \"int\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"lock_user_account\",\n      \"description\": \"POST /api/admin/users/{id}/lock \\u2014 Lock a user account.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"locked\",\n          \"user_id\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"unlock_user_account\",\n      \"description\": \"POST /api/admin/users/{id}/unlock \\u2014 Unlock a user account.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"unlocked\",\n          \"user_id\": \"str\",\n          \"failed_login_attempts\": 0\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"admin_reset_password\",\n      \"description\": \"POST /api/admin/users/{id}/reset-password \\u2014 Admin password reset.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"success\",\n          \"user_id\": \"str\",\n          \"temporary_password\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"admin_reset_mfa\",\n      \"description\": \"POST /api/admin/users/{id}/reset-mfa \\u2014 Admin MFA reset.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"mfa_reset_success\",\n          \"user_id\": \"str\",\n          \"mfa_enabled\": false\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_user_audit_log\",\n      \"description\": \"GET /api/admin/audit-log/{user_id} \\u2014 Get user audit log.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"user_id\": \"str\",\n          \"logs\": [\n            {\n              \"action\": \"str\",\n              \"timestamp\": \"str\",\n              \"details\": \"str\"\n            }\n          ]\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    }\n  ]\n}\nTool: {\n  \"platform\": \"auth0\",\n  \"provider\": \"auth0_user_management\",\n  \"description\": \"Auth0 User Identity Management tools for searching users, triggering password resets, and unlocking accounts.\",\n  \"functions\": [\n    {\n      \"function_name\": \"search_user\",\n      \"description\": \"Search Auth0 user profile by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"found\": \"bool\",\n          \"user_id\": \"str\",\n          \"details\": {\n            \"email\": \"str\",\n            \"name\": \"str\",\n            \"blocked\": \"bool\"\n          }\n        },\n        \"not_found\": {\n          \"found\": false,\n          \"user_id\": null\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"trigger_password_reset\",\n      \"description\": \"Sends Auth0 password reset email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"status\": \"success\",\n          \"email_sent\": \"bool\",\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"unlock_user_account\",\n      \"description\": \"Unlocks a locked Auth0 user account by user_id.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"status\": \"unlocked\",\n          \"user_id\": \"str\"\n        },\n        \"error\": {\n          \"status\": \"failed\",\n          \"user_id\": \"str\"\n        }\n      }\n    }\n  ]\n}\nTool: {\n  \"platform\": \"email\",\n  \"provider\": \"email_service\",\n  \"description\": \"Email and communication service for sending ticket updates, instructions, or resolution tokens.\",\n  \"functions\": [\n    {\n      \"function_name\": \"send_email\",\n      \"description\": \"Sends an email to the user with ticket updates, instructions, or resolution tokens.\",\n      \"required_inputs\": [\n        \"to_email\",\n        \"subject\",\n        \"body\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"status\": \"ok\",\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"status\": \"error\",\n          \"message\": \"str\"\n        }\n      }\n    }\n  ]\n}"
