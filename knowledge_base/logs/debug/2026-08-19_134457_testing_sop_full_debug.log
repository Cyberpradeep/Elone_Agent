ion\": \"POST /api/admin/users/{id}/reset-mfa \\u2014 Admin MFA reset.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"mfa_reset_success\",\n          \"user_id\": \"str\",\n          \"mfa_enabled\": false\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_user_audit_log\",\n      \"description\": \"GET /api/admin/audit-log/{user_id} \\u2014 Get user audit log.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"user_id\": \"str\",\n          \"logs\": [\n            {\n              \"action\": \"str\",\n              \"timestamp\": \"str\",\n              \"details\": \"str\"\n            }\n          ]\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    }\n  ]\n}\nTool: {\n  \"platform\": \"auth0\",\n  \"provider\": \"auth0_user_management\",\n  \"description\": \"Auth0 User Identity Management tools for searching users, triggering password resets, and unlocking accounts.\",\n  \"functions\": [\n    {\n      \"function_name\": \"search_user\",\n      \"description\": \"Search Auth0 user profile by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"found\": \"bool\",\n          \"user_id\": \"str\",\n          \"details\": {\n            \"email\": \"str\",\n            \"name\": \"str\",\n            \"blocked\": \"bool\"\n          }\n        },\n        \"not_found\": {\n          \"found\": false,\n          \"user_id\": null\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"trigger_password_re