        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"disable_mfa\",\n      \"description\": \"POST /api/mfa/disable \\u2014 Disable MFA for the current user.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_enabled\": false\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"reset_mfa\",\n      \"description\": \"POST /api/mfa/reset \\u2014 Reset MFA, returns new secret and provisioning URI.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"mfa_secret\": \"str\",\n          \"provisioning_uri\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"list_users\",\n      \"description\": \"GET /api/admin/users \\u2014 Get paginated list of all users.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"users\": [\n            {\n              \"id\": \"int\",\n              \"email\": \"str\",\n              \"full_name\": \"str\",\n              \"locked\": \"bool\"\n            }\n          ],\n          \"total\": \"int\",\n          \"page\": \"int\",\n          \"per_page\": \"int\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"search_users\",\n      \"description\": \"GET /api/admin/users/search?email= \\u2014 Search users by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"users\": [\n            {\n              \"id\": \"int\",\n              \"email\": \"str\",\n              \"full_name\": \"str\",\n              \"locked\": \"bool\"\n            }\n          ]\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_user_details\",\n      \"description\": \"GET /api/admin/users/{id} \\u2014 Get detailed user profile.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"id\": \"int\",\n          \"email\": \"str\",\n          \"full_name\": \"str\",\n          \"status\": \"str\",\n          \"locked\": \"bool\",\n          \"mfa_enabled\": \"bool\",\n          \"failed_login_attempts\": \"int\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"lock_user_account\",\n      \"description\": \"POST /api/admin/users/{id}/lock \\u2014 Lock a user account.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"locked\",\n          \"user_id\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"unlock_user_account\",\n      \"description\": \"POST /api/admin/users/{id}/unlock \\u2014 Unlock a user account.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"unlocked\",\n          \"user_id\": \"str\",\n          \"failed_login_attempts\": 0\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"admin_reset_password\",\n      \"description\": \"POST /api/admin/users/{id}/reset-password \\u2014 Admin password reset.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"success\",\n          \"user_id\": \"str\",\n          \"temporary_password\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"admin_reset_mfa\",\n      \"description\": \"POST /api/admin/users/{id}/reset-mfa \\u2014 Admin MFA reset.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"status\": \"mfa_reset_success\",\n          \"user_id\": \"str\",\n          \"mfa_enabled\": false\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_user_audit_log\",\n      \"description\": \"GET /api/admin/audit-log/{user_id} \\u2014 Get user audit log.\",\n      \"required_inputs\": [\n        \"user_id\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"user_id\": \"str\",\n          \"logs\": [\n            {\n              \"action\": \"str\",\n              \"timestamp\": \"str\",\n              \"details\": \"str\"\n            }\n          ]\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    }\n  ]\n}\nTool: {\n  \"platform\": \"auth0\",\n  \"provider\": \"auth0_user_management\",\n  \"description\": \"Auth0 User Identity Management tools for searching users, triggering password resets, and unlocking accounts.\",\n  \"functions\": [\n    {\n      \"function_name\": \"search_user\",\n      \"description\": \"Search Auth0 user profile by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n  