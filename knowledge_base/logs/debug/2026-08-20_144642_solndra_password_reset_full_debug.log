\": null,\n            \"expected_output_contains\": \"temporary_password\",\n            \"timeout_seconds\": 30,\n            \"output_variable\": \"password_generated\",\n            \"output_parse_instruction\": \"Inspect the 'temporary_password' field in the response. If present, set 'password_generated' to 'true' and store the password in variables.temporary_password.\",\n            \"execute_if\": \"variables.verification_success == 'true'\",\n            \"is_dangerous\": false,\n            \"danger_warning\": null\n        },\n        {\n            \"step_number\": 4,\n            \"sop_step_description\": \"Resolve the ticket with an audit note.\",\n            \"step_type\": \"tool_call\",\n            \"step_reasoning\": \"Gate 1-4 passed: The SOP requires logging the resolution note and setting the ticket to 'Resolved'. The 'resolve_ticket' function matches this action, and the 'ticket_id' and 'resolution_note' are available.\",\n            \"platform\": \"solandra\",\n            \"function_name\": \"resolve_ticket\",\n            \"comm_inputs\": {\n                \"ticket_id\": \"{{entities.ticket_id}}\",\n                \"resolution_note\": \"Identity verified (2 of 4 checks). Temporary password issued via CoreID. Force-change-at-next-sign-in enabled. No OTP sent - admin-mediated reset per policy.\"\n            },\n            \"command\": null,\n            \"shell\": null,\n            \"fallback_command\": null,\n            \"fallback_sop_id\": null,\n            \"expected_output_contains\": \"Resolved\",\n            \"timeout_seconds\": 30,\n            \"output_variable\": \"ticket_resolved\",\n            \"output_parse_instruction\": \"Inspect the 'status' field in the response. If 'status' is 'Resolved', set 'ticket_resolved' to 'true'.\",\n            \"execute_if\": \"variables.password_generated == 'true'\",\n            \"is_dangerous\": false,\n            \"danger_warning\": null\n        }\n    ]\n}\n```",
