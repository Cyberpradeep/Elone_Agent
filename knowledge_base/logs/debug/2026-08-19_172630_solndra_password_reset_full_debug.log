 \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"verify_mfa_login\",\n      \"description\": \"POST /api/auth/login/mfa \\u2014 Verify MFA code after login.\",\n      \"required_inputs\": [\n        \"temp_token\",\n        \"mfa_code\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"access_token\": \"str\",\n          \"user\": {\n            \"id\": \"int\",\n            \"email\": \"str\"\n          }\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"logout\",\n      \"description\": \"POST /api/auth/logout \\u2014 Invalidate the current access token.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"get_current_user\",\n      \"description\": \"GET /api/auth/me \\u2014 Get the current authenticated user profile.\",\n      \"required_inputs\": [],\n      \"response_schema\": {\n        \"success\": {\n          \"id\": \"int\",\n          \"email\": \"str\",\n          \"full_name\": \"str\",\n          \"locked\": \"bool\",\n          \"mfa_enabled\": \"bool\"\n        },\n        \"error\": {\n          \"error\": \"str\",\n          \"code\": \"int\"\n        }\n      }\n    },\n    {\n      \"function_name\": \"request_password_reset\",\n      \"description\": \"POST /api/password/reset-request \\u2014 Request a password reset token by email.\",\n      \"required_inputs\": [\n        \"email\"\n      ],\n      \"response_schema\": {\n        \"success\": {\n          \"message\": \"str\",\n          \"reset_token\": \"str\"\n        },\n        \"error\": {\n          \"error\": \"st