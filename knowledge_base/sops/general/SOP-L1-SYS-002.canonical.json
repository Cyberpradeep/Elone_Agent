      "action": "List stale files older than seven days in the scratch directory.",
      "input": "Get-ChildItem -Path '{{entities.scratch_path}}' -File | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-7) } | Select-Object Name, LastWriteTime, Length",
