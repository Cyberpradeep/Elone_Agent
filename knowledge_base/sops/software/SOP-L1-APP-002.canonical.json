  "steps": [
    {
      "n": 1,
      "action": "Verify if the target application process is currently running.",
      "input": "tasklist | findstr \"{{entities.application}}\"",
      "expected_outcome": "If stdout contains '{{entities.application}}', set variables.process_running = true, else set variables.process_running = false",
      "warning": null,
      "actor": "agent",
      "requires_approval": false,
      "risk": "low",
      "source_lines": [
        3,
        4
      ],
      "quote": "Verify if the target application process is currently running.",
      "verified": true
    },
    {
      "n": 2,
      "action": "Forcefully terminate the hung application process.",
      "input": "taskkill /F /IM \"{{entities.application}}.exe\"",
      "expected_outcome": "If exit code is 0, set variables.process_terminated = true, else set variables.process_terminated = false",
      "warning": null,
