{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d",
		"name": "L1 Agent Local API Testing",
		"description": "Postman collection to manually test the APIs that the L1 Support Agent calls.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User Management",
			"item": [
				{
					"name": "Search User (By Email)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/users/search?email={{TEST_EMAIL}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"search"
							],
							"query": [
								{
									"key": "email",
									"value": "{{TEST_EMAIL}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get User Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/users/{{TEST_USER_ID}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"{{TEST_USER_ID}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Troubleshooting",
			"item": [
				{
					"name": "Lock Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Locked manually via Postman\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/users/{{TEST_USER_ID}}/lock",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"{{TEST_USER_ID}}",
								"lock"
							]
						}
					},
					"response": []
				},
				{
					"name": "Unlock Account",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/users/{{TEST_USER_ID}}/unlock",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"{{TEST_USER_ID}}",
								"unlock"
							]
						}
					},
					"response": []
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"new_password\": \"NewPassword123!\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/users/{{TEST_USER_ID}}/reset-password",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"{{TEST_USER_ID}}",
								"reset-password"
							]
						}
					},
					"response": []
				},
				{
					"name": "Reset MFA",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/users/{{TEST_USER_ID}}/reset-mfa",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"users",
								"{{TEST_USER_ID}}",
								"reset-mfa"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Audit Logs",
			"item": [
				{
					"name": "Get User Audit Log",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{BASE_URL}}/audit-log/{{TEST_USER_ID}}",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"audit-log",
								"{{TEST_USER_ID}}"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{ADMIN_JWT}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "BASE_URL",
			"value": "http://localhost:5000/api/admin",
			"type": "string"
		},
		{
			"key": "ADMIN_JWT",
			"value": "PASTE_YOUR_JWT_HERE",
			"type": "string"
		},
		{
			"key": "TEST_USER_ID",
			"value": "11",
			"type": "string"
		},
		{
			"key": "TEST_EMAIL",
			"value": "testuser@example.com",
			"type": "string"
		}
	]
}
